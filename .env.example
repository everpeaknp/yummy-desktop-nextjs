# Core backend (auth, orders, payroll, restaurant APIs)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
BACKEND_API_URL=http://127.0.0.1:8001

# Attendance microservice (server-side proxy target)
ATTENDANCE_API_URL=http://127.0.0.1:8002

NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8001/media
NEXT_PUBLIC_MENU_QR_BASE_URL=http://localhost:3002/qr

# Public hostname for this app's own public pages (e.g. /grow/join),
# baked into printed materials like the Growth sign-up QR code.
# REQUIRED before printing/distributing that QR code for real -- without
# it, the QR falls back to whatever origin happens to be open in the
# browser at the time (localhost/staging/etc.), which is fine for
# development but not something to print and hand to a customer.
NEXT_PUBLIC_GROW_PUBLIC_BASE_URL=
